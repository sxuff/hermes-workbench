    "smoke:fixture": "node scripts/fixture-smoke.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "marked": "^16.0.0"
  }
}
