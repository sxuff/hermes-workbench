{
  "name": "hermes-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser-native sessions for Hermes Agent, using its authenticated native gateway.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
